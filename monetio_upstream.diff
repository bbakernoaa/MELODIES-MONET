+"""CESM FV Reader"""
+
+import warnings
+from typing import List, Union
+import numpy as np
+import xarray as xr
+from .base import GriddedReader, register_reader
+from .sat_utils import update_history
+
+@register_reader("cesm_fv")
+class CESMFVReader(GriddedReader):
+    """
+    Reader for CESM FV (Finite Volume / CAM-Chem) data.
+    """
+
+    def open_dataset(
+        self,
+        files: Union[str, List[str]],
+        convert_to_ppb: bool = True,
+        var_list: List[str] = ["O3", "PM25"],
+        surf_only: bool = True,
+        **kwargs,
+    ) -> xr.Dataset:
+        """
+        Reads CESM FV data.
+        """
+        if not surf_only:
+             warnings.warn("3D data processing is still experimental in CESM-FV.")
+
+        if "concat_dim" not in kwargs:
+            kwargs["concat_dim"] = "time"
+        if "combine" not in kwargs:
+            kwargs["combine"] = "nested"
+
+        ds = self.driver.open(files, **kwargs)
+
+        # Vertical info
+        if not surf_only:
+            if "PMID" not in ds.variables:
+                ds["PMID"] = _calc_pressure(ds)
+
+            ds = ds.rename({
+                "T": "temperature_k",
+                "Z3": "alt_msl_m_mid",
+                "PMID": "pres_pa_mid",
+            })
+
+            var_list = list(set(var_list + ["temperature_k", "alt_msl_m_mid", "pres_pa_mid"]))
+
+        available = [v for v in var_list if v in ds.variables]
+        ds = ds[available]
+
+        # Standard Renaming
+        rename_dims = {}
+        if "lon" in ds.dims: rename_dims["lon"] = "x"
+        if "lat" in ds.dims: rename_dims["lat"] = "y"
+        if "lev" in ds.dims: rename_dims["lev"] = "z"
+        if rename_dims:
+            ds = ds.rename(rename_dims)
+
+        # Lon/Lat coords
+        if "x" in ds.dims and "y" in ds.dims:
+             # Logic to handle 180 flip and 2D coord creation
+             if np.any(ds["x"] > 180):
+                 ds["x"] = (ds["x"] + 180) % 360 - 180
+                 ds = ds.sortby("x")
+
+             lon = ds["x"]
+             lat = ds["y"]
+             lons, lats = np.meshgrid(lon, lat)
+             ds["longitude"] = (("y", "x"), lons)
+             ds["latitude"] = (("y", "x"), lats)
+             ds = ds.set_coords(["latitude", "longitude"])
+
+        # Re-order z
+        if "z" in ds.dims:
+            ds = ds.sortby("z", ascending=False)
+
+        # Units
+        if convert_to_ppb:
+            for i in ds.data_vars:
+                if "units" in ds[i].attrs:
+                    if "mol/mol" in ds[i].attrs["units"]:
+                        ds[i] = ds[i] * 1e9
+                        ds[i].attrs["units"] = "ppbV"
+                    elif "kg/m3" in ds[i].attrs["units"]:
+                        ds[i] = ds[i] * 1e9
+                        ds[i].attrs["units"] = r"$\mu g m^{-3}$"
+
+        ds = update_history(ds, "Read CESM FV data.")
+        return ds
+
+def _calc_pressure(ds):
+    # Simplified hybrid pressure calculation
+    p0 = ds.attrs.get("P0", 100000.0)
+    if "P0" in ds.variables: p0 = ds["P0"]
+    return ds.hyam * p0 + ds.hybm * ds.PS
+
+def open_mfdataset(fname, **kwargs):
+    return CESMFVReader().open_dataset(files=fname, **kwargs)
