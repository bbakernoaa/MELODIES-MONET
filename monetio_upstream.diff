+"""CESM SE Reader"""
+
+from typing import List, Union
+import xarray as xr
+from .base import GriddedReader, register_reader
+from .sat_utils import update_history
+
+@register_reader("cesm_se")
+class CESMSEReader(GriddedReader):
+    """
+    Reader for CESM SE (Spectral Element) unstructured grid data.
+    """
+
+    def open_dataset(
+        self,
+        files: Union[str, List[str]],
+        convert_to_ppb: bool = True,
+        var_list: List[str] = ["O3", "NO", "NO2", "lat", "lon"],
+        scrip_file: str = "",
+        **kwargs,
+    ) -> xr.Dataset:
+        """
+        Reads CESM SE data.
+        """
+        if "concat_dim" not in kwargs:
+            kwargs["concat_dim"] = "time"
+        if "combine" not in kwargs:
+            kwargs["combine"] = "nested"
+
+        ds = self.driver.open(files, **kwargs)
+
+        # Ensure required coords are kept
+        vars_to_keep = list(set(var_list + ["lat", "lon", "lev"]))
+        available = [v for v in vars_to_keep if v in ds.variables]
+        ds = ds[available]
+
+        # Renaming
+        if "lev" in ds.dims:
+            ds = ds.rename({"lev": "z"})
+
+        # Sort so surface is first
+        if "z" in ds.dims:
+            ds = ds.sortby("z", ascending=False)
+
+        # Unstructured grid metadata
+        ds.attrs["mio_has_unstructured_grid"] = True
+        ds.attrs["mio_scrip_file"] = scrip_file
+
+        # Unit conversions
+        if convert_to_ppb:
+            for i in ds.data_vars:
+                if "units" in ds[i].attrs:
+                    if "mol/mol" in ds[i].attrs["units"]:
+                        ds[i] = ds[i] * 1e9
+                        ds[i].attrs["units"] = "ppbV"
+                    elif "kg/m3" in ds[i].attrs["units"]:
+                        ds[i] = ds[i] * 1e9
+                        ds[i].attrs["units"] = r"$\mu g m^{-3}$"
+
+        ds = update_history(ds, "Read CESM SE data.")
+        return ds
+
+def open_mfdataset(fname, **kwargs):
+    return CESMSEReader().open_dataset(files=fname, **kwargs)
