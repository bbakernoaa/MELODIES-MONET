+# SPDX-License-Identifier: Apache-2.0
+#
+import pandas as pd
+import xarray as xr
+
+def open_dataset(fname, **kwargs):
+    """
+    Open aircraft data from a CSV file.
+
+    Parameters
+    ----------
+    fname : str
+        The path to the CSV file.
+    **kwargs
+        Additional arguments passed to pandas.read_csv.
+
+    Returns
+    -------
+    xr.Dataset
+    """
+    df = pd.read_csv(fname, **kwargs)
+
+    # Standardize time
+    if 'time' in df.columns:
+        df['time'] = pd.to_datetime(df['time'])
+    elif 'datetime' in df.columns:
+        df['time'] = pd.to_datetime(df['datetime'])
+        df = df.drop(columns=['datetime'])
+
+    # Standardize coordinates
+    rename_dict = {}
+    if 'lat' in df.columns and 'latitude' not in df.columns:
+        rename_dict['lat'] = 'latitude'
+    if 'lon' in df.columns and 'longitude' not in df.columns:
+        rename_dict['lon'] = 'longitude'
+    if 'alt' in df.columns and 'altitude' not in df.columns:
+        rename_dict['alt'] = 'altitude'
+
+    if rename_dict:
+        df = df.rename(columns=rename_dict)
+
+    # Drop rows with missing coordinates or time
+    df = df.dropna(subset=['time', 'latitude', 'longitude'])
+
+    # Convert to xarray
+    ds = df.to_xarray()
+
+    # Add index 'x' as spatial dimension for monet pairing
+    if 'index' in ds.coords:
+        ds = ds.rename({'index': 'x'})
+    else:
+        ds = ds.rename_dims({'dim_0': 'x'})
+
+    return ds
