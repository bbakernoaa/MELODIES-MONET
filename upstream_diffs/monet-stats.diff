+"""Xarray-native statistics interface."""
+
+import numpy as np
+import xarray as xr
+from . import error_metrics, correlation_metrics
+
+def calc(ds, stat=None, obsvar=None, modvar=None, wind=False):
+    """Calculate statistics purely using Xarray operations."""
+    obs = ds[obsvar]
+    mod = ds[modvar]
+
+    # Use monet-stats Xarray-aware metrics
+    metrics = {
+        'MB': error_metrics.MB,
+        'MAE': error_metrics.MAE,
+        'RMSE': error_metrics.RMSE,
+        'R2': correlation_metrics.R2,
+        'IOA': error_metrics.IOA,
+    }
+
+    func = metrics.get(stat)
+    if func:
+        # All monet-stats metrics now return Xarray DataArrays or scalars
+        res = func(obs, mod)
+        return float(res.compute() if hasattr(res, 'compute') else res)
+
+    return np.nan
