+def vert_interp(ds_model, df_obs, var_name_list, **kwargs):
+    """Vertical interpolation of model data to observation points.
+    Leverages monet's resample_stratify for performance and Dask support.
+
+    Parameters
+    ----------
+    ds_model : xarray.Dataset
+        Model data with vertical dimension.
+    df_obs : pandas.DataFrame
+        Observation data with 'pressure_obs' and 'time'.
+    var_name_list : list of str
+        List of variables to interpolate.
+
+    Returns
+    -------
+    pandas.DataFrame
+        Observation DataFrame with interpolated model variables.
+    """
+    from .resample import resample_stratify
+
+    # 1. Spatial pairing first using monet.pair logic (nearest neighbor)
+    # Convert obs points to xarray for remap
+    from ..accessors.pandas_accessor import MONETAccessorPandas
+    obs_points = MONETAccessorPandas(df_obs[['latitude', 'longitude']].drop_duplicates())._df_to_da()
+    ds_model_points = obs_points.monet.remap(ds_model, method="nearest")
+
+    # 2. Time interpolation if needed
+    if "time" in ds_model_points.dims:
+        ds_model_points = ds_model_points.interp(time=pd.to_datetime(df_obs.time.unique()))
+
+    # 3. Vertical interpolation
+    ds_model_points["pressure_model_nan"] = ds_model_points["pressure_model"].copy()
+    all_vars = list(var_name_list) + ["pressure_model_nan"]
+
+    var_out_list = []
+    # Target levels from observations
+    levels = sorted(df_obs.pressure_obs.unique(), reverse=True)
+
+    for var_name in all_vars:
+        if var_name not in ds_model_points: continue
+        out = resample_stratify(ds_model_points[var_name], levels, ds_model_points["pressure_model"], axis=1)
+        out.name = var_name
+        var_out_list.append(out)
+
+    df_model = xr.merge(var_out_list).to_dataframe().reset_index()
+    df_model.rename(columns={"pressure_model": "pressure_obs"}, inplace=True)
+
+    return pd.merge_asof(
+        df_obs.sort_values("time"),
+        df_model.sort_values("time"),
+        by=["latitude", "longitude", "pressure_obs"],
+        on="time",
+        direction="nearest",
+    )
+
+
+def mobile_and_ground_pair(ds_model, df_obs, var_name_list):
+    """Pair mobile or ground site data with model surface data using monet.pair.
+
+    Parameters
+    ----------
+    ds_model : xarray.Dataset
+        Model data.
+    df_obs : pandas.DataFrame
+        Observation data.
+    var_name_list : list of str
+        Variables to pair.
+
+    Returns
+    -------
+    pandas.DataFrame
+        Observation DataFrame with paired model variables.
+    """
+    # Simply delegate to the new pair function which handles this case
+    return pair(ds_model[var_name_list], df_obs, method="nearest", merge=True)
