+"""Aircraft CSV Reader"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import pandas as pd
+import xarray as xr
+
+from .base import PointReader, register_reader
+
+if TYPE_CHECKING:
+    import dask.dataframe as dd
+
+
+@register_reader("aircraft_csv")
+class AircraftCSVReader(PointReader):
+    """Reader for aircraft observations in CSV format."""
+
+    fixed_location = False
+
+    def open_dataset(
+        self,
+        files: str | list[str],
+        time_var: str | None = None,
+        as_xarray: bool = True,
+        lazy: bool = False,
+        **kwargs,
+    ) -> xr.Dataset | pd.DataFrame | dd.DataFrame:
+        """Retrieve and load aircraft CSV data.
+
+        Parameters
+        ----------
+        files : Union[str, List[str]]
+            File path, list of paths, or glob pattern.
+        time_var : str, optional
+            The column name for time.
+        as_xarray : bool, optional
+            Whether to return an xarray.Dataset, by default True.
+        lazy : bool, optional
+            Whether to return a dask-backed object, by default False.
+        **kwargs : dict
+            Additional arguments passed to the reader and driver.
+
+        Returns
+        -------
+        Union[pd.DataFrame, xr.Dataset, dd.DataFrame]
+            The loaded data.
+        """
+
+        def read_func(f, **kws):
+            df = pd.read_csv(f)
+            if time_var is not None:
+                df.rename(columns={time_var: "time"}, inplace=True)
+                df["time"] = pd.to_datetime(df["time"])
+            df.sort_values(by="time", inplace=True, ignore_index=True)
+            return df
+
+        df = self.driver.open(files, read_method=read_func, lazy=lazy, **kwargs)
+        df = self.harmonize(df)
+
+        if as_xarray:
+            return self.to_xarray(df, **kwargs)
+
+        return df
