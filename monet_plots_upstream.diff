+class AircraftCurtainPlot(BasePlot):
+    """Specialized aircraft curtain plot with model background and obs overlay."""
+
+    def __init__(
+        self,
+        time: np.ndarray,
+        altitude: np.ndarray,
+        model_data_2d: np.ndarray,
+        obs_pressure: np.ndarray,
+        pairdf: pd.DataFrame,
+        mod_var: str,
+        obs_var: str,
+        **kwargs: Any,
+    ):
+        """
+        Initialize Aircraft Curtain Plot.
+
+        Parameters
+        ----------
+        time : np.ndarray
+            1D array of time points.
+        altitude : np.ndarray
+            1D array of altitude/pressure points for the model grid.
+        model_data_2d : np.ndarray
+            2D array (time, altitude) of model data.
+        obs_pressure : np.ndarray
+            1D array of pressure points for observations.
+        pairdf : pd.DataFrame
+            DataFrame containing paired model/obs data for scatter overlay.
+        mod_var : str
+            Name of model variable in pairdf.
+        obs_var : str
+            Name of observation variable in pairdf.
+        **kwargs : Any
+            Keyword arguments passed to BasePlot.
+        """
+        # This plot typically uses two subplots
+        if "fig" not in kwargs:
+            kwargs["figsize"] = kwargs.get("figsize", (20, 8))
+            fig, axs = plt.subplots(nrows=2, sharex=True, gridspec_kw={"height_ratios": [1, 1]}, **{k:v for k,v in kwargs.items() if k in ["figsize", "dpi"]})
+            kwargs["fig"] = fig
+            kwargs["ax"] = axs[0]
+
+        super().__init__(**kwargs)
+        self.axs = self.fig.get_axes()
+        self.time = time
+        self.altitude = altitude
+        self.model_data_2d = model_data_2d
+        self.obs_pressure = obs_pressure
+        self.pairdf = pairdf
+        self.mod_var = mod_var
+        self.obs_var = obs_var
+
+    def plot(self, cmin=None, cmax=None, cmap="viridis", norm=None, **kwargs):
+        """Generate the aircraft curtain plot."""
+        if cmin is None: cmin = min(np.nanmin(self.model_data_2d), np.nanmin(self.pairdf[self.obs_var]))
+        if cmax is None: cmax = max(np.nanmax(self.model_data_2d), np.nanmax(self.pairdf[self.obs_var]))
+
+        if norm is None:
+            norm = plt.Normalize(vmin=cmin, vmax=cmax)
+
+        time_dates = mdates.date2num(self.time)
+        time_mesh, altitude_mesh = np.meshgrid(time_dates, self.altitude, indexing="ij")
+
+        # 1. Model Curtain (Top Subplot)
+        levels = np.linspace(cmin, cmax, 200)
+        cf = self.axs[0].contourf(time_mesh, altitude_mesh, self.model_data_2d, levels=levels, cmap=cmap, norm=norm, extend="both")
+
+        # 2. Model Scatter Overlay (Top Subplot)
+        self.axs[0].scatter(time_dates, self.obs_pressure, c=self.pairdf[self.mod_var], cmap=cmap, norm=norm, edgecolor="black", linewidth=0.5, alpha=0.7)
+
+        # 3. Obs Scatter (Bottom Subplot)
+        self.axs[1].scatter(time_dates, self.obs_pressure, c=self.pairdf[self.obs_var], cmap=cmap, norm=norm, edgecolor=(0,0,0,0), linewidth=0.3, alpha=0.5)
+
+        # Formatting
+        for ax in self.axs:
+            ax.invert_yaxis()
+            ax.xaxis.set_major_formatter(mdates.DateFormatter("%m-%d %H"))
+            ax.xaxis.set_major_locator(mdates.AutoDateLocator())
+
+        self.fig.autofmt_xdate(rotation=45, ha="right")
+
+        cbar = self.fig.colorbar(cf, ax=self.axs.tolist(), orientation="horizontal", pad=0.1, aspect=50)
+        return self.axs
