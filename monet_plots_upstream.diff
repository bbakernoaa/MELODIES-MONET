++from __future__ import annotations
++
++from typing import Any
++
++import matplotlib.pyplot as plt
++import pandas as pd
++import seaborn as sns
++
++from .base import BasePlot
++
++
++class ViolinPlot(BasePlot):
++    """Create a violin plot from combined datasets."""
++
++    def __init__(
++        self,
++        data: pd.DataFrame,
++        order: list[str] = None,
++        palette: dict[str, str] = None,
++        **kwargs: Any,
++    ) -> None:
++        """Initialize the violin plot.
++
++        Parameters
++        ----------
++        data : pandas.DataFrame
++            DataFrame in wide or long format.
++        order : list of str, optional
++            Order to plot the categorical levels in.
++        palette : dict, optional
++            Colors to use for the different levels of the hue variable.
++        **kwargs : Any
++            Additional keyword arguments passed to BasePlot.
++        """
++        super().__init__(**kwargs)
++        self.data = data
++        self.order = order
++        self.palette = palette
++
++    def plot(self, **kwargs: Any) -> plt.Axes:
++        """Generate the violin plot.
++
++        Parameters
++        ----------
++        **kwargs : Any
++            Additional keyword arguments passed to seaborn.violinplot.
++
++        Returns
++        -------
++        matplotlib.axes.Axes
++            The axes object with the violin plot.
++        """
++        if self.data.empty:
++            return self.ax
++
++        # If data is in wide format, melt it for seaborn
++        if self.order and all(col in self.data.columns for col in self.order):
++            plot_df = pd.melt(self.data[self.order], var_name="group", value_name="value")
++            x, y = "group", "value"
++        else:
++            plot_df = self.data
++            x = kwargs.pop("x", None)
++            y = kwargs.pop("y", None)
++
++        # Track B defaults often use width normalization
++        final_kwargs = {
++            "cut": 0,
++            "orient": "v",
++            "density_norm": "width",
++            "inner": "quartile",
++            "order": self.order,
++            "palette": self.palette,
++        }
++        final_kwargs.update(kwargs)
++
++        sns.violinplot(data=plot_df, x=x, y=y, ax=self.ax, **final_kwargs)
++
++        return self.ax
